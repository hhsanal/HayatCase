@using Application.Features.SensorDataFeature.GetSensorDataListBySensorId
@using Domain.Enums
@model FactorySensorDataListModel

@{
	ViewData["Title"] = "DataList";
}
<style>
	.threshold-exceeded {
		background-color: #dc3545 !important;
		color: white !important;
	}

</style>

<div class="row mb-3">
	<div class="col-12">
		<div class="card border-1">
			<div class="card-body">
				<div class="d-flex flex-wrap align-items-center justify-content-between">
					<div class="mb-2">
						<h5 class="card-title mb-1">@Model.sensor.Code <span>(Eşik Değeri: @Model.sensor.ThresholdValue)</span> </h5>
						<p class="card-text mb-0">@Model.sensor.Description</p>
						<small class="text-muted">@Model.sensor.Location</small>
					</div>


					<a class="btn btn-outline-secondary btn-sm" href="javascript:history.back()">
						<i class="bi bi-arrow-left"></i> Geri dön
					</a>
				</div>

			</div>
		</div>
	</div>
</div>


<div class="row">
	<div class="col-md-7 col-sm-6">
		<div class="card shadow-sm ">
			<div class="card-body py-1 px-0">
				<div class="table-responsive">
					<table class="table mb-0">
						<thead class="table-light">
							<tr>
								<th scope="col">TimeStamp</th>
								<th scope="col">Gecikme Süresi</th>
								<th scope="col">Değer</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var data in Model.data)
							{
								<tr>


									<td class="@(data.isThresholdExceeded ? "threshold-exceeded" : "")">@data.TimeStamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
									<td class="@(data.isThresholdExceeded ? "threshold-exceeded" : "")">@data.DelayTime</td>

									<td class="@(data.isThresholdExceeded ? "threshold-exceeded" : "")">
										@switch (Model.sensor.Unit)
										{
											case SensorUnit.Celsius:
												@:<span class=" @(data.isThresholdExceeded ? "threshold-exceeded" : "")">@data.Value °C</span>
												break;
											case SensorUnit.Percentage:
												@:<span class=" @(data.isThresholdExceeded ? "threshold-exceeded" : "")">@data.Value %</span>
												break;
											default:
												@:<span class="text-secondary @(data.isThresholdExceeded ? "threshold-exceeded" : "")">Bilinmeyen veri tipi</span>
												break;
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
	<div class="col-md-5 col-sm-6"></div>
</div>
